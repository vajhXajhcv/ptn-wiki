---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/global.css';

const characters = await getCollection('characters');
const stages = await getCollection('stages');
const stories = await getCollection('stories');
const updates = await getCollection('updates');

const byDateDesc = (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
const latestUpdates = [...updates].sort(byDateDesc).slice(0, 5);
const recentActivities = updates.filter((u) => u.data.type === '活动').sort(byDateDesc).slice(0, 3);

const quickLinks = [
	{
		label: '角色图鉴',
		href: '/characters',
		desc: `查看全部 ${characters.length} 名角色`,
	},
	{
		label: '关卡攻略',
		href: '/stages',
		desc: `查看全部 ${stages.length} 个关卡`,
	},
	{
		label: '剧情文本',
		href: '/stories',
		desc: `查看全部 ${stories.length} 段剧情`,
	},
	{
		label: '活动日历',
		href: '/calendar',
		desc: '版本更新与限时活动时间线',
	},
];

const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: Astro.site?.toString(),
	description: SITE_DESCRIPTION,
	potentialAction: {
		'@type': 'SearchAction',
		target: new URL('/search?q={search_term_string}', Astro.site).toString(),
		'query-input': 'required name=search_term_string',
	},
};
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<section class="hero">
			<h1 class="hero-title">{SITE_TITLE}</h1>
			<p class="hero-desc">{SITE_DESCRIPTION}</p>
			<p class="hero-sub">
				非官方、非营利、玩家共建的《无期迷途》中文资料站
			</p>
			<form class="hero-search" action="/search" method="get" role="search">
				<input
					type="search"
					name="q"
					placeholder="搜索角色、关卡、剧情、玩法…"
					aria-label="站内搜索"
				/>
				<button type="submit">搜索</button>
			</form>
		</section>

		<section class="section">
			<div class="card-grid quick-links">
				{quickLinks.map((link) => (
					<a href={link.href} class="card quick-link-card">
						<h3>{link.label}</h3>
						<p>{link.desc}</p>
					</a>
				))}
			</div>
		</section>

		{latestUpdates.length > 0 && (
			<section class="section">
				<div class="section-header">
					<h2 class="section-title">最新动态</h2>
					<a href="/updates" class="section-more">查看全部 →</a>
				</div>
				<div class="update-list">
					{latestUpdates.map((u) => (
						<a href={`/updates/${u.id}/`} class="update-card">
							<span class="update-date">{u.data.date}</span>
							<span class="update-type">{u.data.type}</span>
							<strong>{u.data.title}</strong>
						</a>
					))}
				</div>
			</section>
		)}

		{recentActivities.length > 0 && (
			<section class="section">
				<div class="section-header">
					<h2 class="section-title">近期活动</h2>
					<a href="/calendar" class="section-more">活动日历 →</a>
				</div>
				<div class="update-list">
					{recentActivities.map((u) => (
						<a href={`/updates/${u.id}/`} class="update-card">
							<span class="update-date">{u.data.date}</span>
							<span class="update-type">{u.data.type}</span>
							<strong>{u.data.title}</strong>
						</a>
					))}
				</div>
			</section>
		)}
	</main>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

<style>
	.hero {
		text-align: center;
		padding: 3em 1em;
		margin-bottom: 2em;
		background: linear-gradient(180deg, #f8fafc 0%, #fff 100%);
		border-radius: 16px;
		border: 1px solid rgb(var(--gray-light));
	}
	.hero-title {
		font-size: 2.6em;
		margin-bottom: 0.3em;
	}
	.hero-desc {
		font-size: 1.1em;
		color: rgb(var(--gray));
		margin-bottom: 0.5em;
	}
	.hero-sub {
		font-size: 0.95em;
		color: rgb(var(--gray));
		margin-bottom: 1.5em;
	}
	.hero-search {
		display: flex;
		justify-content: center;
		gap: 0.5em;
		max-width: 520px;
		margin: 0 auto;
	}
	.hero-search input {
		flex: 1;
		padding: 0.65em 1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		font-size: 1em;
	}
	.hero-search input:focus {
		outline: none;
		border-color: var(--accent);
	}
	.hero-search button {
		padding: 0.65em 1.4em;
		border: none;
		border-radius: 8px;
		background: var(--accent);
		color: #fff;
		font-size: 1em;
		cursor: pointer;
		transition: background 0.2s;
	}
	.hero-search button:hover {
		background: var(--accent-dark);
	}
	.section {
		margin-bottom: 2.5em;
	}
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 0.8em;
	}
	.section-title {
		font-size: 1.5em;
		margin: 0;
	}
	.section-more {
		font-size: 0.85em;
		color: var(--accent);
		text-decoration: none;
	}
	.section-more:hover {
		text-decoration: underline;
	}
	.quick-links {
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
	}
	.quick-link-card {
		text-align: center;
	}
	.quick-link-card h3 {
		color: var(--accent-dark);
	}
	.update-list {
		display: grid;
		gap: 0.8em;
	}
	.update-card {
		display: flex;
		align-items: center;
		gap: 1em;
		flex-wrap: wrap;
		padding: 0.9em 1.1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		background: #fff;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s;
	}
	.update-card:hover {
		border-color: var(--accent);
	}
	.update-date {
		font-size: 0.85em;
		color: rgb(var(--gray));
		min-width: 90px;
	}
	.update-type {
		font-size: 0.75em;
		padding: 0.15em 0.5em;
		border-radius: 4px;
		background: #eef2ff;
		color: var(--accent-dark);
	}
	@media (max-width: 720px) {
		.hero-title { font-size: 2em; }
		.hero { padding: 2em 1em; }
	}
</style>
