---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DetailHeader from '../../components/DetailHeader.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE_TITLE } from '../../consts';
import { breadcrumbJsonLd, articleJsonLd } from '../../lib/seo';
import storyCgs from '../../data/story-cgs.json';
import officialWps from '../../data/official-wallpapers.json';
import officialCgDups from '../../data/official-cg-duplicates.json';
import mainChapterMap from '../../data/main-story-chapters.json';
import '../../styles/global.css';

export async function getStaticPaths() {
	const stories = await getCollection('stories');
	return stories.map((story) => ({
		params: { id: story.id },
		props: { story },
	}));
}

const { story } = Astro.props;
const { Content } = await render(story);
const title = `${story.data.title} - ${SITE_TITLE}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const d = story.data;

const breadcrumbItems = [
	{ label: '首页', href: '/' },
	{ label: '剧情', href: '/stories' },
	{ label: d.title },
];

const badges = [
	{ label: d.type },
	d.chapter && { label: d.chapter },
	d.section && { label: d.section },
].filter(Boolean) as { label: string }[];

const meta = [
	d.characters && d.characters.length > 0 && { label: '出场角色', value: d.characters.join('、') },
].filter(Boolean) as { label: string; value: string }[];

// 连续阅读：同一篇章/活动内按文件名自然序排序（numeric 保证 2-1 排在 10-1 前）
const allStories = await getCollection('stories');
const groupKey = (s: (typeof allStories)[number]) => `${s.data.type}|${s.data.chapter || ''}`;
const peers = allStories
	.filter((s) => groupKey(s) === groupKey(story))
	.sort((a, b) => a.id.localeCompare(b.id, 'zh-Hans-CN', { numeric: true }));
const currentIndex = peers.findIndex((s) => s.id === story.id);
const prevStory = currentIndex > 0 ? peers[currentIndex - 1] : null;
const nextStory = currentIndex >= 0 && currentIndex < peers.length - 1 ? peers[currentIndex + 1] : null;
// 目录编号：主线取关卡号（去掉「剧情」后缀），活动/审查不显示编号
const peerLabel = (s: (typeof peers)[number]) => (/^\d/.test(s.id) ? s.id.replace(/剧情$/, '') : '');

// 活动留影 CG：chapter 与 CG 活动名做归一化匹配（去标点、双向包含，如 刹雨/繁花 ↔ 刹雨·繁花）
// 主线剧情额外用 build-main-chapter-map 生成的 页→章节名候选（行名优先、海报名兜底）
type CgItem = { file: string; thumb: string; full: string; width: number; height: number };
const cgsByEvent = storyCgs as Record<string, CgItem[]>;
const normName = (s: string) => s.replace(/[^\p{Script=Han}\p{L}\p{N}]/gu, '');
const chapterCandidates = [d.chapter, ...((mainChapterMap as Record<string, string[]>)[story.id] || [])].filter(
	Boolean,
) as string[];
const matchByNorm = (keys: string[]) => {
	for (const cand of chapterCandidates) {
		const nc = normName(cand);
		const hit = keys.find((e) => {
			const n = normName(e);
			return n === nc || n.includes(nc) || nc.includes(n);
		});
		if (hit) return hit;
	}
	return undefined;
};
const cgEvent = matchByNorm(Object.keys(cgsByEvent));
const cgList: CgItem[] = cgEvent ? cgsByEvent[cgEvent] : [];
// 图片标注：去掉「留影 {活动}-」前缀与扩展名，保留序号（含男女主差分后缀）
const cgLabel = (file: string) => file.replace(/^留影 .+?-/, '').replace(/\.[a-z]+$/i, '');

// 官网影像资料馆「CG壁纸」：按活动名做同样的归一化匹配
type OfficialWp = { id: number; title: string; landscape: string; portrait: string };
const officialWpsData = officialWps as Record<string, Record<string, OfficialWp[]>>;
const officialCgByTag = officialWpsData['CG壁纸'] || {};
const officialEvent = matchByNorm(Object.keys(officialCgByTag));
let officialList: OfficialWp[] = officialEvent ? officialCgByTag[officialEvent] : [];
// 官方 CG 壁纸与活动留影大量同图：按 dedupe-official-cgs 生成的感知哈希结果过滤当前剧情下的重复项
if (officialEvent && cgEvent) {
	const dupIds = new Set(
		(officialCgDups as Record<string, Record<string, number[]>>)[officialEvent]?.[cgEvent] || [],
	);
	if (dupIds.size > 0) officialList = officialList.filter((w) => !dupIds.has(w.id));
}
// 角色审查页：匹配「审查壁纸」中与角色同名的入狱照
if (officialList.length === 0 && d.type === '角色审查' && d.chapter) {
	officialList = (officialWpsData['审查壁纸']?.['入狱照'] || []).filter((w) => normName(w.title) === normName(d.chapter!));
}
---

<BaseLayout title={title} description={d.description}>
	<main>
		<Breadcrumbs items={breadcrumbItems} />

		<DetailHeader
			title={d.title}
			description={d.description}
			badges={badges}
			meta={meta}
		/>

		{
			d.source && (
				<p class="data-source">
					来源：
					<a href={d.source} target="_blank" rel="noopener noreferrer">
						无期迷途 BWiki
					</a>
				</p>
			)
		}

		<section class="story-content card">
			<Content />
		</section>

		{officialList.length > 0 && (
			<section class="cg-gallery card">
				<h2 class="cg-title">官方壁纸 · {officialEvent || d.chapter}</h2>
				<div class="cg-grid">
					{officialList.map((wp) => (
						<a href={wp.landscape} target="_blank" rel="noopener noreferrer" class="cg-item" title={`${wp.title}（点击查看原图）`}>
							<img src={`${wp.landscape}?x-oss-process=image/resize,w_640`} alt={wp.title} loading="lazy" decoding="async" />
							<span class="cg-label">{wp.title}</span>
						</a>
					))}
				</div>
				<p class="cg-source">
					图片来自<a href="https://wqmt.aisnogames.com/m/archives/gallery" target="_blank" rel="noopener noreferrer">无期迷途官网 · 影像资料馆</a>
				</p>
			</section>
		)}

		{cgList.length > 0 && (
			<section class="cg-gallery card">
				<h2 class="cg-title">活动留影 · {cgEvent}</h2>
				<div class="cg-grid">
					{cgList.map((cg) => (
						<a href={cg.full} target="_blank" rel="noopener noreferrer" class="cg-item" title={`${cg.file}（点击查看原图）`}>
							<img
								src={cg.thumb.replace('/1280px-', '/800px-')}
								data-fallback={cg.thumb}
								onerror="this.onerror=null;this.src=this.dataset.fallback"
								alt={cg.file}
								loading="lazy"
								decoding="async"
							/>
							<span class="cg-label">{cgLabel(cg.file)}</span>
						</a>
					))}
				</div>
				<p class="cg-source">
					留影 CG 来自<a href="https://wiki.biligame.com/wqmt/要务留影" target="_blank" rel="noopener noreferrer">无期迷途 BWiki</a>
				</p>
			</section>
		)}

		{(prevStory || nextStory) && (
			<nav class="story-pager" aria-label="连续阅读">
				{prevStory ? (
					<a href={`/stories/${prevStory.id}/`} class="pager-link">
						<span class="pager-dir">← 上一篇</span>
						<span class="pager-title">{prevStory.data.title}</span>
					</a>
				) : <span class="pager-placeholder" />}
				{nextStory ? (
					<a href={`/stories/${nextStory.id}/`} class="pager-link next">
						<span class="pager-dir">下一篇 →</span>
						<span class="pager-title">{nextStory.data.title}</span>
					</a>
				) : <span class="pager-placeholder" />}
			</nav>
		)}

		{peers.length > 1 && (
			<details class="chapter-toc card">
				<summary>{d.chapter || d.type} · 全 {peers.length} 篇目录</summary>
				<ol>
					{peers.map((s) => (
						<li class:list={[{ current: s.id === story.id }]}>
							{s.id === story.id ? (
								<strong>{peerLabel(s)} {s.data.title}</strong>
							) : (
								<a href={`/stories/${s.id}/`}>{peerLabel(s)} {s.data.title}</a>
							)}
						</li>
					))}
				</ol>
			</details>
		)}
	</main>

	<JsonLd data={breadcrumbJsonLd(breadcrumbItems, Astro.site)} />
	<JsonLd data={articleJsonLd({ title, description: d.description, url: canonicalUrl, site: Astro.site })} />
</BaseLayout>

<style>
	.data-source {
		font-size: 0.9em;
		color: rgb(var(--gray));
		margin: -0.5em 0 1em;
	}
	.story-content {
		padding: 1.5em;
	}
	.story-content :global(p) {
		margin-bottom: 1em;
	}
	.cg-gallery {
		margin-top: 1.5em;
		padding: 1.2em 1.5em;
	}
	.cg-title {
		margin: 0 0 0.8em;
		font-size: 1.05em;
		color: var(--accent-dark);
	}
	.cg-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 0.8em;
	}
	.cg-item {
		display: block;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgb(var(--gray-light));
		transition: border-color 0.2s, transform 0.2s;
	}
	.cg-item:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.cg-item img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}
	.cg-label {
		display: block;
		padding: 0.3em 0.5em;
		font-size: 0.8em;
		color: rgb(var(--gray));
		text-align: center;
	}
	.cg-source {
		margin: 0.9em 0 0;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.story-pager {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		margin-top: 1.5em;
	}
	.pager-link {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		padding: 0.9em 1.1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		background: #fff;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s;
	}
	.pager-link:hover {
		border-color: var(--accent);
	}
	.pager-link.next {
		text-align: right;
	}
	.pager-dir {
		font-size: 0.8em;
		color: var(--accent);
	}
	.pager-title {
		font-weight: 500;
	}
	.pager-placeholder {
		flex: 1;
	}
	.chapter-toc {
		margin-top: 1.5em;
		padding: 1em 1.5em;
	}
	.chapter-toc summary {
		cursor: pointer;
		font-weight: 500;
		color: var(--accent-dark);
	}
	.chapter-toc ol {
		columns: 2;
		margin: 1em 0 0.5em;
		padding-left: 1.4em;
	}
	.chapter-toc li {
		margin-bottom: 0.35em;
		break-inside: avoid;
	}
	.chapter-toc li a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.chapter-toc li a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.chapter-toc li.current strong {
		color: var(--accent-dark);
	}
	@media (max-width: 640px) {
		.chapter-toc ol {
			columns: 1;
		}
		.story-pager {
			flex-direction: column;
		}
		.pager-link.next {
			text-align: left;
		}
	}
</style>
