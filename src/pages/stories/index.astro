---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import CardGrid from '../../components/CardGrid.astro';
import FilterBar from '../../components/FilterBar.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/global.css';

const TYPE_ORDER = ['主线', '活动', '支线', '角色审查', '其他'];
const ARC_ORDER = ['狄斯西区·铁血篇', '里湾·锈火篇', '新城·悬城篇', '新城·覆海篇'];

const stories = (await getCollection('stories')).sort((a, b) => {
	const typeDiff = TYPE_ORDER.indexOf(a.data.type || '其他') - TYPE_ORDER.indexOf(b.data.type || '其他');
	if (typeDiff !== 0) return typeDiff;
	// 主线按篇章顺序，活动按活动名
	const arcA = ARC_ORDER.indexOf(a.data.chapter || '');
	const arcB = ARC_ORDER.indexOf(b.data.chapter || '');
	const arcDiff = (arcA === -1 ? 99 : arcA) - (arcB === -1 ? 99 : arcB);
	if (arcDiff !== 0) return arcDiff;
	// 序章排在最前，其余按页面编号自然排序
	const key = (s: string) => s.replace(/^序章(\d+)剧情$/, '0-0-$1');
	return key(a.id).localeCompare(key(b.id), 'zh-CN', { numeric: true });
});

const types = TYPE_ORDER.filter((t) => stories.some((s) => s.data.type === t));
const eventChapters = [
	...new Set(
		stories
			.map((s) => s.data.chapter)
			.filter((c): c is string => Boolean(c) && !ARC_ORDER.includes(c!))
	),
].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const chapters = [
	...ARC_ORDER.filter((arc) => stories.some((s) => s.data.chapter === arc)),
	...eventChapters,
];
const totalCount = stories.length;
---

<BaseLayout title={`剧情 - ${SITE_TITLE}`} description="无期迷途主线剧情、活动剧情与支线剧情文本收录。">
	<main>
		<h1 class="page-title">剧情</h1>
		<p class="page-desc">共 {totalCount} 段剧情文本，来源自无期迷途 BWiki。</p>

		<FilterBar>
			<input type="text" id="search" placeholder="搜索标题、章节或角色..." />
			<select id="type-filter">
				<option value="">全部类型</option>
				{types.map((t) => <option value={t}>{t}</option>)}
			</select>
			<select id="chapter-filter">
				<option value="">全部章节</option>
				{chapters.map((c) => <option value={c}>{c}</option>)}
			</select>
			<span id="count" class="filter-count">显示 {totalCount} 个</span>
		</FilterBar>

		<CardGrid id="story-grid">
			{stories.map((s) => (
				<Card
					href={`/stories/${s.id}/`}
					title={s.data.title}
					description={`${s.data.description.slice(0, 60)}...`}
					badges={[
						s.data.type && { label: s.data.type },
						s.data.chapter && { label: s.data.chapter },
					].filter(Boolean) as { label: string }[]}
					footer={s.data.characters && s.data.characters.length > 0 ? `出场：${s.data.characters.slice(0, 6).join('、')}${s.data.characters.length > 6 ? '…' : ''}` : undefined}
					data-title={s.data.title}
					data-type={s.data.type || ''}
					data-chapter={s.data.chapter || ''}
					data-characters={(s.data.characters || []).join(' ')}
				/>
			))}
		</CardGrid>
	</main>
</BaseLayout>

<script is:inline>
	(function () {
		const search = document.getElementById('search');
		const typeFilter = document.getElementById('type-filter');
		const chapterFilter = document.getElementById('chapter-filter');
		const count = document.getElementById('count');
		const cards = Array.from(document.querySelectorAll('#story-grid .card'));

		function filter() {
			const term = search.value.trim().toLowerCase();
			const type = typeFilter.value;
			const chapter = chapterFilter.value;
			let visible = 0;

			cards.forEach((card) => {
				const title = card.dataset.title.toLowerCase();
				const typeMatch = !type || card.dataset.type === type;
				const chapterMatch = !chapter || card.dataset.chapter === chapter;
				const textMatch =
					!term ||
					title.includes(term) ||
					card.dataset.chapter.toLowerCase().includes(term) ||
					(card.dataset.characters && card.dataset.characters.toLowerCase().includes(term));

				const show = typeMatch && chapterMatch && textMatch;
				card.style.display = show ? '' : 'none';
				if (show) visible++;
			});

			count.textContent = `显示 ${visible} 个`;
		}

		search.addEventListener('input', filter);
		typeFilter.addEventListener('change', filter);
		chapterFilter.addEventListener('change', filter);
	})();
</script>
