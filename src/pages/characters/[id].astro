---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DetailHeader from '../../components/DetailHeader.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE_TITLE } from '../../consts';
import { breadcrumbJsonLd, articleJsonLd } from '../../lib/seo';
import galleries from '../../data/galleries.json';
import '../../styles/global.css';

export async function getStaticPaths() {
	const characters = await getCollection('characters');
	return characters.map((character) => ({
		params: { id: character.id },
		props: { character },
	}));
}

const { character } = Astro.props;
const { Content } = await render(character);
const title = `${character.data.name} - ${SITE_TITLE}`;
const ogImage = character.data.image || undefined;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const d = character.data;

// 关联的角色审查剧情（如已收录）
const reviewStory = (await getCollection('stories')).find((s) => s.id === `审查-${character.id}`);

const breadcrumbItems = [
	{ label: '首页', href: '/' },
	{ label: '角色图鉴', href: '/characters' },
	{ label: d.name },
];

const badges = [
	d.rarity && { label: `${d.rarity}级`, variant: `rarity-${d.rarity.toLowerCase()}` as const },
	d.danger && { label: d.danger },
	d.role && { label: d.role },
	d.faction && { label: d.faction },
].filter(Boolean) as { label: string; variant?: string }[];

const tags = (d.tags || []).map((tag) => ({ label: tag, variant: 'tag' as const }));

// 禁闭者画廊：官网公开资讯中该角色的全部图片（生日贺图/装束/壁纸等）
const gallery = (galleries as Record<string, { cover: string; category: string; title: string; url: string }[]>)[character.id] || [];
// 画廊缩略图：CDN 原图可达数 MB，列表展示用 OSS 缩放参数压到 480 宽（与壁纸页一致）
const galleryThumb = (url: string) => `${url}?x-oss-process=image/resize,w_480`;
// 主图来源是否为 BWiki 升阶装束（三阶立绘）
const isAscendedArt = d.imageSource?.category === 'BWiki 升阶装束';
---

<BaseLayout title={title} description={d.description} image={ogImage}>
	<main>
		<Breadcrumbs items={breadcrumbItems} />

		<DetailHeader
			title={d.name}
			description={d.title}
			image={d.image}
			imageAlt={d.name}
			badges={[...badges, ...tags]}
		/>

		{d.aliases && d.aliases.length > 0 && (
			<p class="character-aliases">
				<strong>别名：</strong>{d.aliases.join('、')}
			</p>
		)}

		{d.description && <p class="character-description">{d.description}</p>}

		{reviewStory && (
			<p class="review-link">
				<a href={`/stories/${reviewStory.id}/`}>📖 查看「{d.name}」的角色审查剧情 →</a>
			</p>
		)}

		<div class="prose character-body">
			<Content />
		</div>

		{gallery.length > 0 && (
			<section class="character-gallery">
				<h2>禁闭者画廊</h2>
				<p class="gallery-desc">以下图片来自《无期迷途》官方网站公开资讯，版权归自意网络所有，点击图片查看官网原文。</p>
				<div class="gallery-grid">
					{gallery.map((item) => (
						<a href={item.url} target="_blank" rel="noopener noreferrer" class="gallery-item" title={item.title}>
							<img src={galleryThumb(item.cover)} alt={item.title} loading="lazy" decoding="async" />
							<span class="gallery-category">{item.category}</span>
						</a>
					))}
				</div>
			</section>
		)}

		<p class="data-source">
			{isAscendedArt ? (
				<>主图为升阶装束（三阶立绘），转自无期迷途 BWiki；画廊图片来自《无期迷途》官方网站。素材版权归自意网络所有。技能名称、效果等客观数据参考无期迷途 BWiki 整理。</>
			) : (
				<>角色图片素材来自《无期迷途》官方网站；技能名称、效果等客观数据参考无期迷途 BWiki 整理。</>
			)}
			{d.imageSource && (
				<>
					<br />
					当前图片源自
					<a href={d.imageSource.url} target="_blank" rel="noopener noreferrer">
						「{d.imageSource.title}」
					</a>
					（{d.imageSource.category}）
				</>
			)}
		</p>
	</main>

	<JsonLd data={breadcrumbJsonLd(breadcrumbItems, Astro.site)} />
	<JsonLd data={articleJsonLd({ title, description: d.description, url: canonicalUrl, site: Astro.site, image: ogImage })} />
</BaseLayout>

<style>
	.character-aliases {
		margin: -0.5em 0 1em;
		color: rgb(var(--gray));
		font-size: 0.95em;
	}
	.character-description {
		margin: 0 0 1.5em;
		color: rgb(var(--gray-dark));
		font-size: 1.05em;
		line-height: 1.7;
	}
	.review-link {
		margin: -0.5em 0 1.5em;
	}
	.review-link a {
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
	}
	.review-link a:hover {
		text-decoration: underline;
	}
	.character-body {
		margin-top: 1.5em;
	}
	.character-gallery {
		margin-top: 2.5em;
	}
	.character-gallery h2 {
		font-size: 1.4em;
		margin-bottom: 0.3em;
	}
	.gallery-desc {
		color: rgb(var(--gray));
		font-size: 0.9em;
		margin: 0 0 1em;
	}
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 1em;
	}
	.gallery-item {
		position: relative;
		display: block;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgb(var(--gray-light));
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.gallery-item:hover {
		transform: translateY(-2px);
		box-shadow: var(--box-shadow);
	}
	.gallery-item img {
		width: 100%;
		height: 180px;
		object-fit: cover;
		display: block;
	}
	.gallery-category {
		position: absolute;
		left: 0.5em;
		bottom: 0.5em;
		padding: 0.15em 0.6em;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.65);
		color: #fff;
		font-size: 0.75em;
	}
</style>
